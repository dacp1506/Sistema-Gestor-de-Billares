{
  "name": "bola8-workspace",
  "version": "0.2.0",
  "private": true,
  "description": "Sistema de gestión multi-sucursal Bola8",
  "scripts": {
    "start": "npm --prefix backend start",
    "dev": "npm --prefix backend run dev",
    "frontend:web": "npm --prefix frontend run web",
    "frontend:android": "npm --prefix frontend run android",
    "frontend:ios": "npm --prefix frontend run ios",
    "check": "npm --prefix backend run check && npm --prefix frontend run typecheck"
  }
}
