# URL de la API del backend.
# Web / escritorio:      http://127.0.0.1:3000/api
# Emulador Android:      http://10.0.2.2:3000/api
# Dispositivo físico:    http://<IP_LAN_DE_TU_PC>:3000/api  (ej. http://192.168.1.103:3000/api)
# Tras cambiarla, reinicia Expo con: npx expo start -c
EXPO_PUBLIC_API_URL=http://192.168.1.103:3000/api
